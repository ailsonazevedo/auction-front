{
  "name": "auction",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "analyze": "npx cross-env ANALYZE=true next build",
    "dev": "next dev",
    "turbo": "next dev --turbo",
    "build": "next build",
    "gerar": "plop && yarn lint:fix",
    "start": "next start",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write --list-different . && eslint --fix .",
    "prepare": "husky .husky",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "test:coverage": "jest --coverage --ci"
  },
  "husky": {
    "hooks": {
      "pre-commit": "prettier --write . && git add -A .",
      "prepare-commit-msg": "exec < /dev/tty && npx cz --hook || true"
    }
  },
  "lint-staged": {
    "*": "prettier --write"
  },
